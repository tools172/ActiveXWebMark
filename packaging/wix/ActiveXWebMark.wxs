<?xml version="1.0" encoding="UTF-8"?>
<!--
  ActiveXWebMark — WiX (v4/v5) installer.

  Build (run from the repository root; set WIX_VERSION and AWM_EXE first):
    wix build -o dist/ActiveXWebMark-1.2.3.msi packaging/wix/ActiveXWebMark.wxs

  - WIX_VERSION: MSI version, three numeric segments (e.g. 1.2.3).
  - AWM_EXE: absolute path to the built ActiveXWebMark.exe.
  The CI release workflow sets both from the tag (see .github/workflows/release.yml).

  Prerequisite: Microsoft Visual C++ 2015-2022 Redistributable (x64). The
  application links the CRT dynamically (/MD). To bundle the runtime into this
  MSI instead, add a <Merge> for Microsoft_VC143_CRT_x64.msm and reference it
  from a <Feature> via <MergeRef>.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ActiveXWebMark"
           Manufacturer="ActiveXWebMark"
           Version="$(env.WIX_VERSION)"
           UpgradeCode="{8A2B9C4D-6E7F-4A5B-9C8D-1E2F3A4B5C6D}"
           Scope="perMachine"
           Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ActiveXWebMark is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Icon shown in Settings > Apps / Programs and Features. -->
    <!-- SourceFile is resolved against the working directory: run wix build
         from the repository root (as the CI release workflow does). -->
    <Icon Id="AppIcon" SourceFile="src\app\resources\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ActiveXWebMark">
        <Directory Id="MermaidFolder" Name="mermaid" />
        <Directory Id="PlantUmlFolder" Name="plantuml" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ActiveXWebMark" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="MainExe"
              Source="$(env.AWM_EXE)"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Node sidecar and Mermaid bundle used for diagram rendering. -->
    <ComponentGroup Id="MermaidComponents" Directory="MermaidFolder">
      <Component Id="MermaidSidecar" Guid="*">
        <File Id="MermaidSidecarFile"
              Source="third_party\mermaid\sidecar.cjs"
              KeyPath="yes" />
      </Component>
      <Component Id="MermaidBundle" Guid="*">
        <File Id="MermaidBundleFile"
              Source="third_party\mermaid\mermaid.min.js"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- PlantUML headless native runtime staged by tools\plantuml-native\fetch.ps1.
         A missing file makes the WiX build fail before an installer is produced. -->
    <ComponentGroup Id="PlantUmlComponents" Directory="PlantUmlFolder">
      <Component Id="PlantUmlExe" Guid="*">
        <File Id="PlantUmlExeFile"
              Source="build\plantuml-native\staging\plantuml-headless.exe"
              KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlAwt" Guid="*">
        <File Id="PlantUmlAwtFile" Source="build\plantuml-native\staging\awt.dll" KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlFontManager" Guid="*">
        <File Id="PlantUmlFontManagerFile" Source="build\plantuml-native\staging\fontmanager.dll" KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlFreetype" Guid="*">
        <File Id="PlantUmlFreetypeFile" Source="build\plantuml-native\staging\freetype.dll" KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlJavaDll" Guid="*">
        <File Id="PlantUmlJavaDllFile" Source="build\plantuml-native\staging\java.dll" KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlAccessBridge" Guid="*">
        <File Id="PlantUmlAccessBridgeFile" Source="build\plantuml-native\staging\javaaccessbridge.dll" KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlJpeg" Guid="*">
        <File Id="PlantUmlJpegFile" Source="build\plantuml-native\staging\javajpeg.dll" KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlJawt" Guid="*">
        <File Id="PlantUmlJawtFile" Source="build\plantuml-native\staging\jawt.dll" KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlJvm" Guid="*">
        <File Id="PlantUmlJvmFile" Source="build\plantuml-native\staging\jvm.dll" KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlLcms" Guid="*">
        <File Id="PlantUmlLcmsFile" Source="build\plantuml-native\staging\lcms.dll" KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlMlibImage" Guid="*">
        <File Id="PlantUmlMlibImageFile" Source="build\plantuml-native\staging\mlib_image.dll" KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlLicense" Guid="*">
        <File Id="PlantUmlLicenseFile"
              Source="build\plantuml-native\staging\LICENSE.plantuml"
              KeyPath="yes" />
      </Component>
      <Component Id="PlantUmlLicenseNotice" Guid="*">
        <File Id="PlantUmlLicenseNoticeFile"
              Source="build\plantuml-native\staging\license.txt"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="StartMenuShortcutComponents" Directory="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="ActiveXWebMark"
                  Target="[INSTALLFOLDER]ActiveXWebMark.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\ActiveXWebMark"
                       Name="StartMenuInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutComponents" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="ActiveXWebMark"
                  Target="[INSTALLFOLDER]ActiveXWebMark.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\ActiveXWebMark"
                       Name="DesktopInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      Markdown file association. Registers the application as a candidate
      handler; Windows 10 does not let an installer force the default, the
      user confirms it in Settings > Default apps. Windows Installer removes
      these values again on uninstall.
    -->
    <ComponentGroup Id="AssociationComponents" Directory="INSTALLFOLDER">
      <Component Id="MarkdownAssociations" Guid="*" Bitness="always64">
        <RegistryKey Root="HKLM" Key="Software\Classes\ActiveXWebMark.Markdown">
          <RegistryValue Type="string" Value="Markdown 文档" KeyPath="yes" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="Markdown 文档" />
          <RegistryValue Key="DefaultIcon" Type="string"
                         Value="[INSTALLFOLDER]ActiveXWebMark.exe,0" />
          <RegistryValue Key="shell\open" Name="MultiSelectModel" Type="string"
                         Value="Player" />
          <RegistryValue Key="shell\open\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]ActiveXWebMark.exe&quot; &quot;%1&quot;" />
        </RegistryKey>

        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\ActiveXWebMark.exe">
          <RegistryValue Name="FriendlyAppName" Type="string" Value="ActiveXWebMark" />
          <RegistryValue Name="ApplicationCompany" Type="string" Value="ActiveXWebMark" />
          <RegistryValue Key="DefaultIcon" Type="string"
                         Value="[INSTALLFOLDER]ActiveXWebMark.exe,0" />
          <RegistryValue Key="shell\open" Name="MultiSelectModel" Type="string"
                         Value="Player" />
          <RegistryValue Key="shell\open\command" Type="string"
                         Value="&quot;[INSTALLFOLDER]ActiveXWebMark.exe&quot; &quot;%1&quot;" />
          <RegistryValue Key="SupportedTypes" Name=".md" Type="string" Value="" />
          <RegistryValue Key="SupportedTypes" Name=".markdown" Type="string" Value="" />
          <RegistryValue Key="SupportedTypes" Name=".mdown" Type="string" Value="" />
        </RegistryKey>

        <RegistryKey Root="HKLM" Key="Software\ActiveXWebMark\Capabilities">
          <RegistryValue Name="ApplicationName" Type="string" Value="ActiveXWebMark" />
          <RegistryValue Name="ApplicationDescription" Type="string"
                         Value="Markdown 阅读与编辑" />
          <RegistryValue Key="FileAssociations" Name=".md" Type="string"
                         Value="ActiveXWebMark.Markdown" />
          <RegistryValue Key="FileAssociations" Name=".markdown" Type="string"
                         Value="ActiveXWebMark.Markdown" />
          <RegistryValue Key="FileAssociations" Name=".mdown" Type="string"
                         Value="ActiveXWebMark.Markdown" />
        </RegistryKey>

        <RegistryKey Root="HKLM" Key="Software\RegisteredApplications">
          <RegistryValue Name="ActiveXWebMark" Type="string"
                         Value="Software\ActiveXWebMark\Capabilities" />
        </RegistryKey>

        <RegistryKey Root="HKLM" Key="Software\Classes\.md\OpenWithProgids">
          <RegistryValue Name="ActiveXWebMark.Markdown" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.markdown\OpenWithProgids">
          <RegistryValue Name="ActiveXWebMark.Markdown" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.mdown\OpenWithProgids">
          <RegistryValue Name="ActiveXWebMark.Markdown" Type="string" Value="" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="ActiveXWebMark" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="MermaidComponents" />
      <ComponentGroupRef Id="PlantUmlComponents" />
      <ComponentGroupRef Id="StartMenuShortcutComponents" />
      <ComponentGroupRef Id="DesktopShortcutComponents" />
      <ComponentGroupRef Id="AssociationComponents" />
    </Feature>
  </Package>
</Wix>
